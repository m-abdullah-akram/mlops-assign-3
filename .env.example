# Copy to .env and fill in. .env is git-ignored - NEVER commit real values.
PROJECT_NAME=22l-6632_A2_Ops
COMPOSE_PROJECT_NAME=22l_6632_a2_ops

# --- DagsHub / MLflow (training machine) ---
MLFLOW_TRACKING_URI=https://dagshub.com/ma92365/22l-6632_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=ma92365
MLFLOW_TRACKING_PASSWORD=your-dagshub-access-token

# --- Database (Docker Compose) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=visionguard

# --- Web app ---
MAX_UPLOAD_MB=5
INFERENCE_MODE=local          # local = model inside the container | remote = call the cloud API
# THRESHOLD=0.50              # optional override; default comes from models/champion/metadata.json

# --- Task 7/8: cloud model API ---
API_KEY=change-me-to-a-long-random-string          # set on the cloud server
REMOTE_API_URL=http://YOUR_SERVER_IP:8000           # used by the local Flask app in remote mode
REMOTE_API_KEY=change-me-to-a-long-random-string    # same value as API_KEY
