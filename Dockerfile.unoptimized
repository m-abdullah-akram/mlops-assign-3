# ONLY for Task 6.4 "before" measurement: full base image, full `tensorflow`, pip cache kept,
# everything copied. To measure the full 'before' cost also temporarily rename .dockerignore.
# Build: docker build -f Dockerfile.unoptimized -t visionguard:before .
FROM python:3.11
WORKDIR /srv
COPY . .
RUN sed 's/tensorflow-cpu/tensorflow/' requirements-app.txt > req.txt && pip install -r req.txt
CMD ["flask", "--app", "app.app:create_app", "run", "--host", "0.0.0.0", "--port", "5000"]
